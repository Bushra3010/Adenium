# ── Local development ───────────────────────────────────────────
# Served by `npm run dev:db` (embedded PGlite over the PG wire protocol).
# For production, replace with your real PostgreSQL connection string.
# NOTE: pgbouncer=true is required for the local PGlite dev server — it shares a
# single Postgres backend across pooled connections, so Prisma's named prepared
# statements would otherwise collide. Harmless against real PostgreSQL; drop it
# there unless you actually sit behind PgBouncer.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?connection_limit=10&pgbouncer=true&sslmode=disable"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable"

# ── Production (Supabase) ───────────────────────────────────────
# Take both from: Supabase dashboard -> Connect -> ORMs -> Prisma.
#
# DATABASE_URL  = Transaction pooler, port 6543. Used by the running app.
#                 Serverless functions open a connection per invocation, so it
#                 must be pooled, and pgbouncer=true disables prepared
#                 statements the transaction pooler cannot hold.
# DIRECT_URL    = Session pooler or direct connection, port 5432. Used only by
#                 `prisma migrate`, which needs DDL and advisory locks.
#
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# ── Auth ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ── Site ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Adenium"

# ── Payments: Razorpay (PAY-01). Client-supplied, PRD §11 item 4 ──
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── Email (NOT-01/02). Unset = log to console in development ─────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Adenium <orders@example.com>"
ADMIN_ALERT_EMAIL=""

# ── SMS (NOT-03). Requires TRAI DLT-approved templates, PRD §8.10 ─
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""
