# ── Local development ───────────────────────────────────────────
# Served by `npm run dev:db` (embedded PGlite over the PG wire protocol).
# For production, replace with your real PostgreSQL connection string.
# NOTE: pgbouncer=true is required for the local PGlite dev server — it shares a
# single Postgres backend across pooled connections, so Prisma's named prepared
# statements would otherwise collide. Harmless against real PostgreSQL; drop it
# there unless you actually sit behind PgBouncer.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?connection_limit=10&pgbouncer=true&sslmode=disable"

# ── Auth ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ── Site ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Adenium"

# ── Payments: Razorpay (PAY-01). Client-supplied, PRD §11 item 4 ──
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── Email (NOT-01/02). Unset = log to console in development ─────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Adenium <orders@example.com>"
ADMIN_ALERT_EMAIL=""

# ── SMS (NOT-03). Requires TRAI DLT-approved templates, PRD §8.10 ─
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""
