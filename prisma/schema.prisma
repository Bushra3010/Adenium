// Adenium — E-Commerce Platform
// Data model per PRD §7. Provider: PostgreSQL (PRD §10).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

/// Drives variant behaviour and the attribute set (PRD §7.1).
enum ProductType {
  SEED
  PLANT
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// PRD ORD-01.
enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Which product type an option/attribute definition applies to.
enum AppliesTo {
  SEED
  PLANT
  BOTH
}

// ─────────────────────────────────────────────────────────────
// Identity & access (PRD §8.7)
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role      @default(CUSTOMER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses   Address[]
  orders      Order[]
  reviews     Review[]
  wishlist    WishlistItem[]
  carts       Cart[]
  sessions    Session[]
  tokens      VerificationToken[]
  redemptions CouponRedemption[]

  @@index([role])
}

/// DB-backed so logout genuinely invalidates the session (AUTH-06).
model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the cookie's secret half. A DB leak yields no usable cookies.
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String       @unique
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId, purpose])
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Catalog (PRD §7)
// ─────────────────────────────────────────────────────────────

/// Admin-editable taxonomy, nestable to 2+ levels (PRD §6).
model Category {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  description String?
  imageUrl    String?
  type        ProductType
  parentId    String?
  parent      Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryTree")
  position    Int         @default(0)
  isActive    Boolean     @default(true)

  metaTitle       String?
  metaDescription String?

  products ProductCategory[]

  @@index([parentId])
  @@index([type])
}

model Product {
  id               String        @id @default(uuid())
  type             ProductType
  name             String
  botanicalName    String?
  slug             String        @unique
  sku              String        @unique
  shortDescription String?
  description      String?
  /// Growing / germination / bonsai content — the Care tab (PDP-05).
  careGuide        String?
  status           ProductStatus @default(DRAFT)
  featured         Boolean       @default(false)

  metaTitle       String?
  metaDescription String?

  /// Denormalised from APPROVED reviews only (REV-03).
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories ProductCategory[]
  variants   Variant[]
  images     ProductImage[]
  attributes ProductAttribute[]
  faqs       ProductFaq[]
  reviews    Review[]
  wishlisted WishlistItem[]
  tags       ProductTag[]

  @@index([status, type])
  @@index([featured])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Tag {
  id       String       @id @default(uuid())
  name     String
  slug     String       @unique
  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  variants Variant[]

  @@index([productId])
}

/// Every product has >= 1 variant, seeds included (PRD §7.2, Q1).
model Variant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// e.g. {"pot_size":"5in","height":"12-15cm"} or {"pack_size":"50 seeds"}
  optionValues   Json          @default("{}")
  sku            String        @unique
  price          Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?      @db.Decimal(10, 2)
  /// Physical stock. Available = stockQty - active reservations.
  stockQty       Int           @default(0)
  lowStockAt     Int           @default(3)
  weightG        Int           @default(100)
  imageId        String?
  image          ProductImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  isDefault      Boolean       @default(false)
  isActive       Boolean       @default(true)

  cartItems    CartItem[]
  orderItems   OrderItem[]
  reservations StockReservation[]

  @@index([productId])
}

/// Admin-definable option types — not a fixed enum (PRD §7.2).
model OptionType {
  id        String            @id @default(uuid())
  key       String            @unique
  label     String
  appliesTo AppliesTo         @default(BOTH)
  position  Int               @default(0)
  values    OptionTypeValue[]
}

model OptionTypeValue {
  id           String     @id @default(uuid())
  optionTypeId String
  optionType   OptionType @relation(fields: [optionTypeId], references: [id], onDelete: Cascade)
  value        String
  position     Int        @default(0)

  @@unique([optionTypeId, value])
}

/// Horticultural attribute registry (PRD §7.3).
model Attribute {
  id         String    @id @default(uuid())
  key        String    @unique
  label      String
  unit       String?
  appliesTo  AppliesTo @default(BOTH)
  /// Controls whether this appears as a category filter (SRCH-04).
  filterable Boolean   @default(false)
  position   Int       @default(0)

  values ProductAttribute[]
}

model ProductAttribute {
  productId   String
  attributeId String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String

  @@id([productId, attributeId])
  @@index([attributeId, value])
}

model ProductFaq {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  position  Int     @default(0)

  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
// Cart (PRD §8.4)
// ─────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(uuid())
  /// Set for signed-in carts (CART-02).
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Anonymous cart token held in an httpOnly cookie.
  token     String   @unique
  couponId  String?
  coupon    Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@index([userId])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([cartId, variantId])
  @@index([variantId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
// Orders (PRD §8.9)
// ─────────────────────────────────────────────────────────────

model Order {
  id          String @id @default(uuid())
  /// Human-facing reference, e.g. ADN-100042.
  orderNumber String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Captured for guest checkout and for the tracking lookup (ORD-05).
  email String
  phone String

  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(PENDING)

  // Address snapshot — never a live FK, so later edits cannot rewrite history.
  shipFullName String
  shipPhone    String
  shipLine1    String
  shipLine2    String?
  shipLandmark String?
  shipCity     String
  shipState    String
  shipPincode  String

  billSameAsShip Boolean @default(true)
  billFullName   String?
  billLine1      String?
  billLine2      String?
  billCity       String?
  billState      String?
  billPincode    String?

  subtotal      Decimal @db.Decimal(10, 2)
  discountTotal Decimal @default(0) @db.Decimal(10, 2)
  shippingTotal Decimal @default(0) @db.Decimal(10, 2)
  taxTotal      Decimal @default(0) @db.Decimal(10, 2)
  grandTotal    Decimal @db.Decimal(10, 2)

  couponId   String?
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode String?

  // Gateway (PAY-05)
  gatewayOrderId   String?
  gatewayPaymentId String?
  gatewaySignature String?
  paidAt           DateTime?

  // Fulfilment (ORD-03)
  courierName  String?
  awbNumber    String?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  customerNote String?
  adminNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        OrderItem[]
  events       OrderEvent[]
  reservations StockReservation[]
  redemption   CouponRedemption?
  reviews      Review[]

  @@index([userId])
  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Snapshot at purchase time — the catalog may change afterwards.
  productId    String
  productName  String
  productSlug  String
  variantLabel String
  sku          String
  imageUrl     String?
  unitPrice    Decimal @db.Decimal(10, 2)
  quantity     Int
  lineTotal    Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

/// Timestamped, audit-logged state transitions (ORD-02).
model OrderEvent {
  id        String       @id @default(uuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus?
  message   String
  actor     String       @default("system")
  createdAt DateTime     @default(now())

  @@index([orderId])
}

/// Holds stock between order creation and payment (CHK-07); expiry sweeps it back.
model StockReservation {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([variantId])
  @@index([expiresAt])
  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────
// Coupons (PRD §8.12)
// ─────────────────────────────────────────────────────────────

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  description   String?
  discountType  DiscountType
  /// Percent when PERCENTAGE, rupees when FIXED, ignored for FREE_SHIPPING.
  value         Decimal      @default(0) @db.Decimal(10, 2)
  maxDiscount   Decimal?     @db.Decimal(10, 2)
  minOrderValue Decimal      @default(0) @db.Decimal(10, 2)

  startsAt DateTime?
  endsAt   DateTime?

  usageLimit        Int?
  usageLimitPerUser Int?
  timesUsed         Int  @default(0)

  /// Empty means all products/categories.
  scopeCategoryIds String[] @default([])
  scopeProductIds  String[] @default([])

  /// CPN-05 — stacking is off unless explicitly enabled.
  stackable Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  carts       Cart[]
  orders      Order[]
  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@index([couponId, userId])
  @@index([couponId, email])
}

// ─────────────────────────────────────────────────────────────
// Reviews (PRD §8.12)
// ─────────────────────────────────────────────────────────────

model Review {
  id              String       @id @default(uuid())
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating          Int
  title           String?
  body            String
  status          ReviewStatus @default(PENDING)
  /// REV-04 — set when a delivered order for this product exists.
  verifiedOrderId String?
  verifiedOrder   Order?       @relation(fields: [verifiedOrderId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Content & settings (PRD §8.13, ADM-10)
// ─────────────────────────────────────────────────────────────

model Page {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  body            String
  isPublished     Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  updatedAt       DateTime @updatedAt
}

/// Care & growing guides — the organic-search asset (CMS-03).
model Guide {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  excerpt         String?
  body            String
  coverImage      String?
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

/// Key/value store for shipping rates, thresholds, senders, etc.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}
